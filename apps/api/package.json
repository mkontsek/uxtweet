{
  "name": "@uxtweet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env.defaults --env-file-if-exists=.env src/server.ts",
    "build": "tsup src/server.ts --format esm --out-dir dist",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@fastify/websocket": "11.2.0",
    "@uxtweet/shared": "workspace:*",
    "fastify": "5.8.5",
    "kysely": "0.29.2",
    "pg": "8.11.5",
    "prom-client": "15.1.3",
    "redis": "6.0.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "@types/uuid": "10.0.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "2.1.9",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "ws": "8.21.0"
  }
}
