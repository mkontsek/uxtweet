{
  "name": "uxtweet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm db:up && turbo run dev",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @uxtweet/e2e run e2e",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,jsx,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,js,jsx,json,md}\" --ignore-path .prettierignore",
    "typecheck": "turbo run typecheck",
    "deploy:local": "./scripts/build.sh && ./scripts/deploy.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,cjs,mjs,vue,json,jsonc,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "prettier": "3.8.3",
    "turbo": "2.9.16",
    "typescript": "5.9.3"
  }
}
